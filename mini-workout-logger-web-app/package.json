{
  "name": "mini-workout-logger-web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/web",
    "packages/mobile"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev:web": "npm run dev --workspace=@mini/web",
    "dev:mobile": "npm run dev --workspace=@mini/mobile",
    "build:shared": "npm run build --workspace=@mini/shared",
    "build:web": "npm run build --workspace=@mini/web"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "~5.9.3"
  }
}
